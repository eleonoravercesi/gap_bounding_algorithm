void print_generator(int n, const C_Polyhedron& poly, const Generator& gen, string filename) {
    bool with_int = false;
    auto den = gen.divisor();
    if (with_int == false && den != 1) {
        // Open file in append mode (creates if doesn't exist, appends if exists)
        ofstream outfile(filename, ios::app);

        if (!outfile.is_open()) {
            cerr << "Error: Cannot open or create file " << filename << "\n";
            return;
        }

        for (size_t i = 0; i < poly.space_dimension(); ++i) {
            if (i == 0) {
                // Just at the beginning
                outfile << n << ",";
            }
            Coefficient coeff = gen.coefficient(Variable(i));
            outfile << coeff << "/" << den;

            // Add space after each coordinate
            if (i < poly.space_dimension() - 1) {
                outfile << " ";
            }
        }

        // Newline at the end of each vertex
        outfile << "\n";

        outfile.close();
    }
}

VertexFraction get_generator(int n, const C_Polyhedron& poly, const Generator& gen, bool with_int = false) {
    auto den = gen.divisor();
    vector<GMP_Integer> v;
    if (with_int == false && den != 1) {
        for (size_t i = 0; i < poly.space_dimension(); ++i) {
            Coefficient coeff = gen.coefficient(Variable(i));
            unsigned long coeff_int = mpz_get_ui(coeff);
            v.push_back(coeff);
        }
    }
    return make_pair(den, v);
}

